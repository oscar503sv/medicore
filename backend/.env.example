# Entorno: "development" (por defecto) o "production".
# En production se activan validaciones estrictas (p. ej. exige un JWT_SECRET fuerte).
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/medicore

# Secreto para firmar los JWT. OBLIGATORIO y fuerte en producción (≥16 chars):
#   openssl rand -hex 32
JWT_SECRET=cambia-esto-en-produccion-usa-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_SUPPORT_EXPIRE_MINUTES=60  # TTL corta para sesiones de suplantación (soporte)

# CORS: orígenes permitidos separados por comas, o "*" para cualquiera (default, dev).
# En producción "*" NO está permitido (la app no arranca): lístalos explícitamente,
# p. ej.: https://app.midominio.com
CORS_ORIGINS=*

# Exponer la documentación interactiva (Swagger/OpenAPI).
# En producción queda desactivada por defecto; ponla a true solo como opt-in deliberado.
ENABLE_DOCS=true

# Reverse-proxies de confianza (IPs o CIDRs separados por coma, p. ej. "127.0.0.1" o
# "10.0.0.0/8"). Solo desde ellos se honra X-Forwarded-For para la IP de auditoría;
# vacío (default) = la cabecera se ignora y se registra la IP del socket.
TRUSTED_PROXIES=
