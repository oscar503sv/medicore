# Entorno: "development" (por defecto) o "production".
# En production se activan validaciones estrictas (p. ej. exige un JWT_SECRET fuerte).
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/medicore

# Secreto para firmar los JWT. OBLIGATORIO y fuerte en producción (≥16 chars):
#   openssl rand -hex 32
JWT_SECRET=cambia-esto-en-produccion-usa-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_SUPPORT_EXPIRE_MINUTES=60  # TTL corta para sesiones de suplantación (soporte)

# CORS: orígenes permitidos separados por comas, o "*" para cualquiera (default, dev).
# En producción "*" NO está permitido (la app no arranca): lístalos explícitamente,
# p. ej.: https://app.midominio.com
CORS_ORIGINS=*

# Exponer la documentación interactiva (Swagger/OpenAPI).
# En producción queda desactivada por defecto; ponla a true solo como opt-in deliberado.
ENABLE_DOCS=true

# Reverse-proxies de confianza (IPs o CIDRs separados por coma, p. ej. "127.0.0.1" o
# "10.0.0.0/8"). Solo desde ellos se honra X-Forwarded-For para la IP de auditoría;
# vacío (default) = la cabecera se ignora y se registra la IP del socket.
TRUSTED_PROXIES=

# Cookies de sesión con flag Secure y prefijos __Host-/__Secure-. Sin definir (default) = se
# deduce del entorno: activas en todo excepto development (http://localhost).
# En production no puede ser false (la app no arranca).
# COOKIE_SECURE=true

# Sesión de la consola de plataforma (superadmin): cierre por inactividad y tope absoluto.
# La inactividad debe estar entre 5 y el tope; el polling de Monitoreo no cuenta como actividad.
PLATFORM_SESSION_IDLE_MINUTES=30
PLATFORM_SESSION_MAX_MINUTES=480
# Ruta de la cookie de sesión de la consola (solo se envía a la API de plataforma).
PLATFORM_COOKIE_PATH=/api/v1/platform

# MFA (TOTP) opcional de los superadmins. La clave cifra los secretos TOTP en la base de datos:
# 32 bytes en base64url. OBLIGATORIA en producción (la app no arranca sin ella); en desarrollo,
# si queda vacía, se deriva de JWT_SECRET. No reutilices JWT_SECRET ni la pierdas: sin ella los
# MFA ya activados no se pueden verificar. Generarla:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MFA_ENCRYPTION_KEY=
# Nombre que muestra la app autenticadora junto al código.
MFA_ISSUER=Medicore
