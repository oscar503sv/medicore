# URL absoluta del backend para el build cuando frontend y backend están en orígenes distintos
# (p. ej. https://api.midominio.com/api/v1). Déjalo vacío para usar el mismo origen vía
# reverse-proxy / proxy de desarrollo (default: /api/v1).
VITE_API_BASE_URL=

# Solo desarrollo: a dónde proxyea `vite dev` las peticiones /api.
VITE_API_PROXY_TARGET=http://localhost:8000
