# ─────────────────────────────────────────────────────────────
# Medicore — monorepo .gitignore (Python backend + Node frontend)
# ─────────────────────────────────────────────────────────────

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/

# Test / coverage / type / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ── Node / frontend ──
node_modules/
frontend/dist/
frontend/.vite/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment / secrets ──
.env
.env.*
!.env.example

# ── Editors / OS ──
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
# VS Code: ignore personal settings but allow shared ones if added explicitly
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
