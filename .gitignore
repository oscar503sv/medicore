# ─────────────────────────────────────────────────────────────
# Medicore — monorepo .gitignore (Python backend + Node frontend)
# ─────────────────────────────────────────────────────────────

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
uv.lock          # uv lockfile — commit if you switch to uv for reproducible builds

# Test / coverage / type / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ── Node / frontend ──
node_modules/
frontend/dist/
frontend/.vite/
.vite/
*.tsbuildinfo
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Bases de datos locales (desarrollo / SQLite) ──
*.db
*.sqlite
*.sqlite3

# ── Claves, certificados y secretos ──
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
jwt_secret*
secrets.toml

# ── Environment / secrets ──
.env
.env.*
!.env.example

# ── Logs y temporales ──
*.log
*.bak
*.orig
*.tmp
*.temp

# ── Editores / IDEs ──
.idea/
*.swp
*.swo
*.iml
# VS Code: ignorar configuración personal, permitir ajustes de equipo si se agregan explícitamente
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ── macOS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# ── Windows ──
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

design_handoff_medicore/